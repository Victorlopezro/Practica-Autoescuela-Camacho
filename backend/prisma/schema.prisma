generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @map("id")
  username  String   @unique @map("username")
  password  String   @map("password")
  role      String   @default("student") @map("role") // admin | teacher | student
  teacherId String?  @map("teacher_id")
  name      String?  @map("name")
  lastName  String?  @map("last_name")
  email     String?  @unique @map("email")
  phone     String?  @map("phone")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  createdById   String?            @map("created_by_id")
  createdBy     User?              @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers  User[]             @relation("CreatedUsers")
  schedulingRules SchedulingRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("id")
  token     String   @unique @map("token")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false) @map("revoked")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ─── Domain Models ───────────────────────────────────────────────────────

model Student {
  id               String   @id @default(uuid()) @map("id")
  userId           String   @unique @map("user_id")
  teacherId        String?  @map("teacher_id")
  licenseType      String?  @map("license_type")
  licenseSubType   String?  @map("license_sub_type") // 'pista' | 'circulacion' | null
  remainingClasses Int      @default(0) @map("remaining_classes")
  balanceHistory   Json?    @map("balance_history") // Array of { amount, reason, timestamp, adjustedBy }

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("students")
}

model Teacher {
  id            String   @id @default(uuid()) @map("id")
  name          String   @map("name")
  doubleSession Boolean  @default(false) @map("double_session")

  availability    TeacherAvailability[]
  overrides       AvailabilityOverride[]
  teacherVehicles TeacherVehicle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teachers")
}

model TeacherAvailability {
  id        String   @id @default(uuid()) @map("id")
  teacherId String   @map("teacher_id")
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week") // 0=Sunday, 1=Monday ... 6=Saturday
  startTime String   @map("start_time") // "HH:mm" in local time
  endTime   String   @map("end_time")
  track     String?  @map("track") // 'pista' | 'circulacion' | null

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teacherId, dayOfWeek, track])
  @@map("teacher_availability")
}

model AvailabilityOverride {
  id          String   @id @default(uuid()) @map("id")
  teacherId   String   @map("teacher_id")
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date        DateTime @map("date")
  isAvailable Boolean  @default(false) @map("is_available")
  startTime   String?  @map("start_time") // null = use regular schedule
  endTime     String?  @map("end_time")
  reason      String?  @map("reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teacherId, date])
  @@map("availability_overrides")
}

model VehicleTypeConfig {
  id       String @id @default(uuid()) @map("id")
  type     String @unique @map("type")
  duration Int    @map("duration") // minutes

  @@map("vehicle_type_config")
}

model Vehicle {
  id        String   @id @default(uuid()) @map("id")
  plate     String   @unique @map("plate")
  type      String   @map("type") // moto-pista | moto-circulacion | coche-manual | coche-automatico
  status    String   @default("available") @map("status") // available | in-use | maintenance | retired
  itvExpiry DateTime? @map("itv_expiry")

  incidents       VehicleIncident[]
  teacherVehicles TeacherVehicle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
}

model VehicleIncident {
  id          String   @id @default(uuid()) @map("id")
  vehicleId   String   @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description String   @map("description")
  date        DateTime @map("date")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("vehicle_incidents")
}

model TeacherVehicle {
  id        String   @id @default(cuid())
  teacherId String   @map("teacher_id")
  vehicleId String   @map("vehicle_id")
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([teacherId, vehicleId])
  @@map("teacher_vehicles")
}

model Reservation {
  id          String   @id @default(uuid()) @map("id")
  studentId   String   @map("student_id")
  teacherId   String   @map("teacher_id")
  vehicleType String   @map("vehicle_type")
  startTime   DateTime @map("start_time")
  duration    Int      @map("duration") // minutes: 45 or 90
  status      String   @default("pending") @map("status") // pending | confirmed | cancelled | completed
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledById      String?   @map("cancelled_by_id")
  cancellationReason String?   @map("cancellation_reason")
  refundAmount       Int?      @map("refund_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teacherId, startTime])
  @@index([studentId, startTime])
  @@map("reservations")
}

// ─── Scheduling Rules ────────────────────────────────────────────────────

model SchedulingRule {
  id              String    @id @default(uuid()) @map("id")
  name            String    @map("name")
  naturalLanguage String    @map("natural_language")
  structuredRules Json?     @map("structured_rules") // null before AI translates
  ruleType        String    @map("rule_type") // availability | overlap | duration | vehicle | general
  action          String    @default("block") @map("action") // allow | block | warn
  priority        Int       @default(100) @map("priority")
  enabled         Boolean   @default(true) @map("enabled")
  appliesTo       Json?     @map("applies_to") // { teacherIds?, licenseTypes?, vehicleTypes? }
  createdById     String    @map("created_by_id")
  createdBy       User      @relation(fields: [createdById], references: [id])
  category        String    @default("evaluation") @map("category") // evaluation | generation
  deletedAt       DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, deletedAt, priority])
  @@map("scheduling_rules")
}

// ─── Payments ────────────────────────────────────────────────────────────

model Payment {
  id               String   @id @default(uuid()) @map("id")
  reservationId    String   @unique @map("reservation_id")
  stripeSessionId  String   @unique @map("stripe_session_id")
  status           String   @default("pending") @map("status") // pending | completed | failed | refunded
  amount           Int      @map("amount") // cents
  idempotencyKey   String?  @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

// ─── Notifications ───────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @map("id")
  recipient String   @map("recipient")
  channel   String   @map("channel") // whatsapp | email
  template  String   @map("template")
  data      Json?    @map("data")
  status    String   @default("pending") @map("status") // pending | sent | failed
  error     String?  @map("error")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ─── Audit ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  action    String   @map("action")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  reason    String?  @map("reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
